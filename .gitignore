# Archivos temporales de Office
~$*
*.tmp
*.bak

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Flutter / Dart (para cuando se agregue el codigo)
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Node / herramientas
node_modules/

# Logs de herramientas (emulador de Firebase, debug)
*.log
firebase-debug.log
firestore-debug.log

# Artefactos de herramientas y editores
.firebase/
.playwright-mcp/
.idea/
.vscode/

# Llaves y credenciales de servicio
serviceAccountKey.json
*.pem

# Variables de entorno y secretos
.env
*.keystore
key.properties

# Respaldos y exportaciones de datos (NO subir: datos sensibles)
auth_usuarios*.json
backups/

# Imágenes de trabajo de la marca (bocetos, fuentes, fotos de prueba).
# Los logos que USA la app viven en app/assets/logos/ y SI se versionan.
Documentacion/marca/

# Credenciales de las cuentas de prueba (contiene contraseñas).
Documentacion/cuentas-demo.md

# Nota: google-services.json / GoogleService-Info.plist SI se versionan.
# Son identificadores publicos del cliente (la seguridad va en las reglas
# de Firestore/Storage y en Authentication), y el plugin de Gradle de
# Android los requiere para compilar.
